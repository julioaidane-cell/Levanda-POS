# Copy this file to `.env` and fill in the values for your environment.
# Expo inlines every EXPO_PUBLIC_* variable into the JS bundle at build time.
# Never commit a real token or credential here.

# Root of the Levanda POS API. The client appends `/api` to this value, so do
# not include the `/api` suffix yourself.
#
# The backend is served over plain HTTP, which is why
# `expo-build-properties > android.usesCleartextTraffic` and the iOS ATS
# exception in app.json are required. See the README.
EXPO_PUBLIC_API_BASE_URL=http://194.163.174.120:8080